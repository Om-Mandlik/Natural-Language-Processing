      "source": [
        "import torch\n",
        "import torch.nn as nn"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "lstm = nn.LSTM(\n",
        "    input_size=10,\n",
        "    hidden_size=20,\n",
        "    num_layers=1,\n",
        "    batch_first=True\n",
        ")"
      ],
      "metadata": {
        "id": "3Y4okqbn32uN"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "x = torch.randn(2, 5, 10)\n",
        "output, (hidden, cell) = lstm(x)\n",
        "print(output.shape)\n",
        "print(hidden.shape)\n",
        "print(cell.shape)"
      ],
