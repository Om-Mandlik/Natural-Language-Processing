      "source": [
        "import torch\n",
        "import torch.nn as nn"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "gru = nn.GRU(\n",
        "    input_size=10,\n",
        "    hidden_size=20,\n",
        "    num_layers=1,\n",
        "    batch_first=True\n",
        ")\n"
      ],
      "metadata": {
        "id": "9BMiAjP37QPK"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "x = torch.randn(2, 5, 10)\n",
        "output, hidden = gru(x)\n",
        "print(output.shape)\n",
        "print(hidden.shape)"
      ],
